{
  "name": "openharness",
  "version": "0.1.0",
  "description": "OpenHarness - 桌面级 Agent Harness 统一集成服务",
  "main": "./out/main/index.js",
  "author": "OpenHarness",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:electron": "electron tests/electron-smoke.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^8.2.0",
    "js-yaml": "^5.4.1",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.7.6",
    "pinia": "^2.1.7",
    "sass": "^1.77.6",
    "vite": "^7.3.6",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "build": {
    "npmRebuild": false,
    "asarUnpack": ["**/node_modules/node-pty/**"],
    "win": {
      "icon": "build/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OpenHarness-Setup-${version}.${ext}"
    },
    "appId": "com.openharness.app",
    "productName": "OpenHarness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ]
  }
}
